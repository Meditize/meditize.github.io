---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts.js';
---

<Base
  title="Blog — Meditize"
  description="Articles on digital fatigue, eye strain and healthier screen habits."
>
  <section class="page-hero wrap" slot="hero">
    <h1>Blog</h1>
    <p>Practical writing on screen habits, focus and eye health.</p>
  </section>

  <section class="section narrow">
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a href={post.href}>
              <article class="card">
                <p class="post-date">{post.date}</p>
                <h3>{post.title}</h3>
                <p class="muted">{post.excerpt}</p>
              </article>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
