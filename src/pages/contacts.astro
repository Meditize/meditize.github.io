---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contacts — Meditize"
  description="Get in touch with the Meditize team about the extension, billing or partnerships."
>
  <section class="page-hero wrap" slot="hero">
    <h1>Contact us</h1>
    <p>Questions, bug reports or partnership ideas — we read everything.</p>
  </section>

  <section class="section narrow">
    <p class="lead">
      Write to <a href="mailto:meditize.app@gmail.com">meditize.app@gmail.com</a> or use the form
      below.
    </p>

    <form class="form" action="https://formsubmit.co/meditize.app@gmail.com" method="POST">
      <label>
        Name
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Message
        <textarea name="message" required></textarea>
      </label>
      <input type="hidden" name="_subject" value="Meditize website enquiry" />
      <input type="text" name="_honey" style="display:none" />
      <button class="btn" type="submit">Send message</button>
    </form>
  </section>
</Base>
