---
import Socials from './Socials.astro';

const store =
  'https://chromewebstore.google.com/detail/eye-exercises-strain-reli/jnmmnipcjejnofidackkaghkddddhaml';
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <a class="brand" href="/">
          <img src="/img/meditize.png" alt="" width="32" height="32" />
          Meditize
        </a>
        <p class="foot-tag" style="margin-top:14px">Reduce Digital Eye Strain While You Work</p>
        <a class="btn" href={store} target="_blank" rel="noopener">Try Meditize — it’s Free</a>
      </div>

      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/science/">Science</a></li>
        </ul>
      </div>

      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/vision/">Vision</a></li>
          <li><a href="/support/">Support</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>

      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contacts/">Contacts</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} Meditize</span>
      <Socials />
    </div>
  </div>
</footer>
