---
const { pathname } = Astro.url;
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/features/', label: 'Features' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/science/', label: 'Science' },
  { href: '/contacts/', label: 'Contacts' },
];
const store =
  'https://chromewebstore.google.com/detail/eye-exercises-strain-reli/jnmmnipcjejnofidackkaghkddddhaml';
---

<header class="site-head">
  <a class="brand" href="/">
    <img src="/img/meditize.png" alt="" width="32" height="32" />
    Meditize
  </a>
  <nav class="site-nav">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <a class="btn" href={store} target="_blank" rel="noopener">Add to Chrome</a>
</header>
